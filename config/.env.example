# Copy to config/.env and fill in. Never commit .env.

NOOKAL_API_KEY=
NOOKAL_API_BASE_URL=https://api.nookal.com/production/v2/

LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b  # Value must match a model present locally in the Ollama registry
LLM_API_KEY=  # often unused for local Ollama; leave blank if not required
# LLM_SHORT_TIMEOUT_SECONDS=30
# LLM_LONG_TIMEOUT_SECONDS=300
# LLM_ENABLE_THINKING=0

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0

# Outbound communications:
# - SMS and Email: Nookal is the sole provider. Handled natively in Nookal PMS.
# - No third-party SMS/email provider credentials (Twilio, SendGrid, SMTP) permitted.
# - WhatsApp: Meta Cloud API (optional).

# Root for absolute paths on the clinic Mac (e.g. /Users/automation)
AUTOMATION_HOME=

# Dashboard (Phase E) — never commit real passwords
# DASHBOARD_DEV_USER=
# DASHBOARD_DEV_PASSWORD=
# DASHBOARD_DEV_ROLE=admin
# AUTOMATION_ALLOW_DEV_LOGIN=1  # local only: print ephemeral password
# BTE_ENV=development
